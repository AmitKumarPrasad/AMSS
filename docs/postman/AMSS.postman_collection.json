  "item": [
    {
      "name": "01 Authentication",
      "item": [
        {
          "name": "Login",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"schooladmin\",\n  \"password\": \"your-password\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/auth/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "auth",
                "login"
              ]
            }
          }
        }
      ]
    },
    {
      "name": "02 Students",
      "item": [
        {
          "name": "List students",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/api/v1/schools/{{schoolId}}/students?status=ACTIVE&page=0&size=50",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "schools",
                "{{schoolId}}",
                "students"
              ],
              "query": [
                {
                  "key": "status",
                  "value": "ACTIVE"
                },
                {
                  "key": "page",
                  "value": "0"
                },
                {
                  "key": "size",
                  "value": "50"
                }
              ]
            }
          }
        },
        {
          "name": "Create student",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"admissionNumber\": \"ADM-2026-001\",\n  \"firstName\": \"Aarav\",\n  \"lastName\": \"Kumar\",\n  \"dateOfBirth\": \"2015-06-20\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/schools/{{schoolId}}/students",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "schools",
                "{{schoolId}}",
                "students"
              ]
            }
          }
        },
        {
          "name": "Activate/deactivate student",
          "request": {
            "method": "PATCH",
            "url": {
              "raw": "{{baseUrl}}/api/v1/schools/{{schoolId}}/students/{{studentId}}/status?active=true",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "schools",
                "{{schoolId}}",
                "students",
                "{{studentId}}",
                "status"
              ],
              "query": [
                {
                  "key": "active",
                  "value": "true"
                }
              ]
            }
          }
        }
      ]
    },
