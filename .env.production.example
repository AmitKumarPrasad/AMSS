# Production configuration template. Copy into your secret manager/runtime environment.
# Never commit the populated file.

POSTGRES_DB=edusphere
POSTGRES_USER=edusphere
POSTGRES_PASSWORD=<generate-a-strong-database-password>
OPENAI_API_KEY=<set-in-secret-manager>
JWT_SECRET=<generate-at-least-32-random-characters>
JWT_ISSUER=https://api.example.com
SPRING_AI_MCP_SERVER_ENABLED=false
LANGGRAPH_BASE_URL=http://ai-orchestrator:8123
NOTIFICATIONS_EMAIL_ENABLED=false
NOTIFICATIONS_SMS_ENABLED=false
NOTIFICATIONS_SMS_TWILIO_ACCOUNT_SID=<set-in-secret-manager>
NOTIFICATIONS_SMS_TWILIO_AUTH_TOKEN=<set-in-secret-manager>
NOTIFICATIONS_SMS_TWILIO_FROM=<set-a-Twilio-enabled-sender>
